# Copy to .env.local. Server-side only (used by app/api/* and lib/data.ts).
NODE_API_URL=http://localhost:5050
SPRING_API_URL=http://localhost:8080

# Supabase: Project Settings -> API. Publishable key only; never put a secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
